# Resend — envoi des emails du formulaire d'audit
# https://resend.com — créez un compte, validez un domaine, copiez la clé API
RESEND_API_KEY=

# Email qui reçoit les demandes d'audit
AUDIT_TO_EMAIL=contact@hi-ve.fr

# Expéditeur (doit être validé sur Resend)
AUDIT_FROM_EMAIL="Hi-Ve <audit@hi-ve.fr>"
